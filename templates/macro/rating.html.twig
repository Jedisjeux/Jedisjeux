{% macro rating(value) %}
    {{ fa_icon('fa fa-star' ~ (value >= 1 ? ' text-default') ~ (value == 1 ? ' fa-star-half-empty')) }}
    {{ fa_icon('fa fa-star' ~ (value >= 3 ? ' text-default') ~ (value == 3 ? ' fa-star-half-empty')) }}
    {{ fa_icon('fa fa-star' ~ (value >= 5 ? ' text-default') ~ (value == 5 ? ' fa-star-half-empty')) }}
    {{ fa_icon('fa fa-star' ~ (value >= 7 ? ' text-default') ~ (value == 7 ? ' fa-star-half-empty')) }}
    {{ fa_icon('fa fa-star' ~ (value >= 9 ? ' text-default') ~ (value == 9 ? ' fa-star-half-empty')) }}
{% endmacro %}

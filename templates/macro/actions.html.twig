{% macro create(cancel_url) %}

    {% import _self as action %}

    <div class="pull-right">
        {{ action.createButton() }}
        {{ action.cancelButton(cancel_url) }}
    </div>
{% endmacro %}

{% macro update(cancel_url) %}

    {% import _self as action %}

    <div class="pull-right">
        {{ action.updateButton() }}
        {{ action.cancelButton(cancel_url) }}
    </div>
{% endmacro %}

{% macro createButton() %}
    <button type="submit"
            class="btn btn-default">
        <i class="fa fa-check" aria-hidden="true">{{ ux_icon('fa:check', {class: 'fa-svg'}) }}</i>
        {{ 'sylius.ui.create'|trans }}
    </button>
{% endmacro %}

{% macro updateButton() %}
    <button type="submit"
            class="btn btn-default">
        <i class="fa fa-save" aria-hidden="true">{{ ux_icon('fa:save', {class: 'fa-svg'}) }}</i>
        {{ 'sylius.ui.save_changes'|trans }}
    </button>
{% endmacro %}

{% macro cancelButton(cancel_url) %}
    <a href="{{ cancel_url|default(app.request.headers.get('referer')) }}"
       class="btn btn-danger">
        <i class="fa fa-remove" aria-hidden="true">{{ ux_icon('fa:remove', {class: 'fa-svg'}) }}</i>
        {{ 'sylius.ui.cancel'|trans }}
    </a>
{% endmacro %}

{% macro search() %}
    <button type="submit"
            class="fa fa-default">
        <i class="fa fa-search" aria-hidden="true">{{ ux_icon('fa:search', {class: 'fa-svg'}) }}</i>
        {{ 'sylius.ui.search'|trans }}
    </button>
{% endmacro %}
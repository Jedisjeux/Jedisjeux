{% if data.user is not null %}
    {% if data.user.enabled %}
        <span class="badge bg-success-lt">{{ ux_icon('tabler:check', {'class': 'icon'}) }} {{ 'sylius.ui.enabled'|trans }}</span>
    {% else %}
        <span class="badge bg-danger-lt">{{ ux_icon('tabler:x', {'class': 'icon'}) }} {{ 'sylius.ui.disabled'|trans }}</span>
    {% endif %}
{% else %}
    <span class="badge bg-secondary-lt">{{ ux_icon('tabler:spy', {'class': 'icon'}) }} {{ 'sylius.ui.guest'|trans }}</span>
{% endif %}

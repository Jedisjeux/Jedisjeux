{{ form_errors(form) }}

<div class="row row-cards">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">{{ 'sylius.ui.customer_details'|trans }}</h3>
            </div>
            <div class="card-body">
                {{ form_row(form.email) }}
                {{ form_row(form.group) }}
                {{ form_row(form.firstName) }}
                {{ form_row(form.lastName) }}
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">{{ 'sylius.ui.account_credentials'|trans }}</h3>
            </div>
            <div class="card-body">
                {% if form.vars.data.user is empty or form.vars.data.user.id is null %}
                    {{ form_row(form.createUser) }}
                {% endif %}
                {% if form.user is defined %}
                    <div id="user-form" {% if form.user.vars.data.id is not defined %}style="display: none"{% endif %}>
                        {{ form_row(form.user.plainPassword) }}
                        {{ form_row(form.user.enabled) }}
                        {{ form_row(form.user.roles) }}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{% if form.vars.data.user is empty or form.vars.data.user.id is null %}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const createUser = document.getElementById('{{ form.createUser.vars.id }}');
        const userForm = document.getElementById('user-form');

        if (createUser && userForm) {
            const toggle = () => { userForm.style.display = createUser.checked ? '' : 'none'; };
            createUser.addEventListener('change', toggle);
            toggle();
        }
    });
</script>
{% endif %}

<div class="card mb-3" id="customer">
    <div class="card-header">
        <h3 class="card-title">{{ 'sylius.ui.customer'|trans }}</h3>
    </div>
    <div class="card-body">
        <a href="{{ path('sylius_backend_customer_show', {'id': customer.id}) }}" class="fw-bold sylius-customer-name">{{ customer }}</a>
        <div class="text-secondary">
            {{ 'sylius.ui.customer_since'|trans }} {{ customer.createdAt|format_datetime('medium', 'none') }}.
        </div>
    </div>
    <div class="list-group list-group-flush">
        <a href="mailto:{{ customer.email }}" class="list-group-item list-group-item-action">
            {{ ux_icon('tabler:mail', {'class': 'icon'}) }}
            {{ customer.email }}
        </a>
        {% if customer.phoneNumber is not empty %}
            <div class="list-group-item">
                {{ ux_icon('tabler:phone', {'class': 'icon'}) }}
                {{ customer.phoneNumber }}
            </div>
        {% endif %}
    </div>
</div>

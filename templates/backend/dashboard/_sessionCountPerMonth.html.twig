<div class="card">
    <div class="card-header">
        <h3 class="card-title">{{ 'app.ui.sessions_of_current_year'|trans }}</h3>
    </div>

    {% if sessions|length > 0 %}
        <div class="table-responsive">
            <table class="table card-table table-vcenter">
                <thead>
                    <tr>
                        <th>{{ 'sylius.ui.date'|trans }}</th>
                        <th>{{ 'app.ui.session_count'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for session in sessions %}
                    <tr>
                        <td>{{ session.date|date('M Y') }}</td>
                        <td>{{ session.sessionCount }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="card-body">
            <div class="alert alert-info mb-0">{{ 'sylius.ui.no_results_to_display'|trans }}</div>
        </div>
    {% endif %}
</div>

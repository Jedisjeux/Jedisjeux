<div class="row row-cards mb-3">
    {% for stat in [
        {'id': 'total-articles', 'value': articleCount, 'label': 'app.ui.articles', 'icon': 'tabler:news'},
        {'id': 'total-products', 'value': productCount, 'label': 'app.ui.games', 'icon': 'tabler:dice'},
        {'id': 'new-customers', 'value': userCount, 'label': 'sylius.ui.customers', 'icon': 'tabler:users'},
        {'id': 'average-order-value', 'value': ratingCount, 'label': 'app.ui.ratings', 'icon': 'tabler:star'},
    ] %}
        <div class="col-sm-6 col-lg-3">
            <div class="card card-sm">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <span class="bg-primary-lt avatar">{{ ux_icon(stat.icon, {'class': 'icon'}) }}</span>
                        </div>
                        <div class="col">
                            <div id="{{ stat.id }}" class="h2 mb-0">{{ stat.value }}</div>
                            <div class="text-secondary">{{ stat.label|trans }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}
</div>

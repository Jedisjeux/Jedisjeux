<div {{ attributes.defaults({class: 'mb-3'}) }}>
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <div class="text-secondary" id="statistics-period">
            {{ ux_icon('tabler:calendar', {'class': 'icon me-1'}) }}
            {{ period_label }}
        </div>
        <div class="d-flex gap-3">
            <div class="btn-group" role="group">
                {% for range in [
                    {'period': '2 weeks', 'interval': 'day', 'label': 'app.ui.statistics.2weeks'},
                    {'period': 'month', 'interval': 'day', 'label': 'app.ui.statistics.month'},
                    {'period': 'year', 'interval': 'month', 'label': 'app.ui.statistics.year'},
                ] %}
                    <button
                        type="button"
                        class="btn {% if period == range.period %}btn-light border{% endif %}"
                        data-action="live#action"
                        data-live-action-param="prevent|changeRange"
                        data-live-period-param="{{ range.period }}"
                        data-live-interval-param="{{ range.interval }}"
                    >
                        {{ range.label|trans }}
                    </button>
                {% endfor %}
            </div>
            <div class="btn-group" role="group">
                <button
                    type="button"
                    class="btn btn-icon"
                    title="{{ 'app.ui.statistics.previous_period'|trans }}"
                    data-action="live#action"
                    data-live-action-param="prevent|getPreviousPeriod"
                >
                    {{ ux_icon('tabler:arrow-left', {'class': 'icon m-0'}) }}
                </button>
                <button
                    type="button"
                    class="btn btn-icon"
                    title="{{ 'app.ui.statistics.next_period'|trans }}"
                    data-action="live#action"
                    data-live-action-param="prevent|getNextPeriod"
                >
                    {{ ux_icon('tabler:arrow-right', {'class': 'icon m-0'}) }}
                </button>
            </div>
        </div>
    </div>

    <div class="row row-cards mb-3" data-loading="addClass(opacity-50)">
        {% for stat in [
            {'id': 'articles', 'key': 'articleCount', 'label': 'app.ui.published_articles', 'icon': 'tabler:news'},
            {'id': 'products', 'key': 'productCount', 'label': 'app.ui.new_games', 'icon': 'tabler:dice'},
            {'id': 'users', 'key': 'userCount', 'label': 'app.ui.new_members', 'icon': 'tabler:users'},
            {'id': 'ratings', 'key': 'ratingCount', 'label': 'app.ui.ratings', 'icon': 'tabler:star'},
        ] %}
            <div class="col-sm-6 col-lg-3">
                <div class="card card-sm">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <span class="bg-primary-lt avatar">{{ ux_icon(stat.icon, {'class': 'icon'}) }}</span>
                            </div>
                            <div class="col">
                                <div class="subheader">{{ stat.label|trans }}</div>
                                <div class="d-flex align-items-baseline">
                                    <div id="period-{{ stat.id }}" class="h2 mb-0 me-2">{{ summary[stat.key] }}</div>
                                    <div class="text-secondary small">
                                        {{ 'app.ui.statistics.total'|trans({'%count%': totals[stat.key]}) }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">{{ 'app.ui.published_articles'|trans }}</h3>
        </div>
        <div class="card-body" data-loading="addClass(opacity-50)">
            <div
                id="article-statistics-chart"
                class="chart-lg"
                data-intervals="{{ statistics.intervals|json_encode }}"
                data-articles-count="{{ statistics.articles_count|json_encode }}"
                data-label="{{ 'app.ui.published_articles'|trans }}"
            ></div>
        </div>
    </div>
</div>

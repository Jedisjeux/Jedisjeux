<div class="card">
    <div class="card-header">
        <h3 class="card-title">{{ 'app.ui.new_articles'|trans }}</h3>
    </div>

    {% if articles|length > 0 %}
        <div class="table-responsive">
            <table class="table card-table table-vcenter" id="articles">
                <tbody>
                {% for article in articles %}
                    <tr>
                        <td>{{ article }}</td>
                        <td>
                            {% include 'backend/grid/field/state.html.twig' with {'data': article.status, 'options': {'vars': {'labels': 'backend/article/label/state'}}} %}
                        </td>
                        <td class="text-end">
                            <a href="{{ path('app_backend_article_update', {'id': article.id}) }}" class="btn btn-icon" data-bs-toggle="tooltip" data-bs-title="{{ 'sylius.ui.edit'|trans }}">
                                {{ ux_icon('tabler:pencil') }}
                            </a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="card-body">
            <div class="alert alert-info mb-0">{{ 'sylius.ui.no_results_to_display'|trans }}</div>
        </div>
    {% endif %}
</div>

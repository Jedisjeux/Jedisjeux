<div class="card">
    <div class="card-header">
        <h3 class="card-title">{{ 'sylius.ui.new_customers'|trans }}</h3>
    </div>

    {% if customers|length > 0 %}
        <div class="table-responsive">
            <table class="table card-table table-vcenter" id="customers">
                <tbody>
                {% for customer in customers %}
                    <tr>
                        <td>
                            <strong>{{ customer }}</strong><br>
                            <span class="text-secondary">{{ customer.email }}</span>
                        </td>
                        <td>
                            {% if customer.user is null %}
                                <span class="badge bg-secondary-lt">
                                    {{ ux_icon('tabler:spy', {'class': 'icon'}) }}
                                    {{ 'sylius.ui.guest'|trans }}
                                </span>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            <a href="{{ path('sylius_backend_customer_show', {'id': customer.id}) }}" class="btn btn-icon" data-bs-toggle="tooltip" data-bs-title="{{ 'sylius.ui.show'|trans }}">
                                {{ ux_icon('tabler:eye') }}
                            </a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="card-body">
            <div class="alert alert-info mb-0">{{ 'sylius.ui.no_results_to_display'|trans }}</div>
        </div>
    {% endif %}
</div>

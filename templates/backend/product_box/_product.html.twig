{% set product = resource.product %}

<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title">{{ 'sylius.ui.product'|trans }}</h3>
    </div>
    <div class="card-body">
        <a href="{{ path('sylius_admin_product_update', {'id': product.id}) }}" class="fw-bold sylius-product-name">{{ product.name }}</a>
    </div>
</div>

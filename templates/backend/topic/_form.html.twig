{{ form_errors(form) }}

<div class="row">
    <div class="col-md-8">
        <div class="card mb-3">
            <div class="card-body">
                {{ form_row(form.title) }}
                {{ form_row(form.mainPost.body) }}
                {{ form_row(form.mainTaxon) }}
            </div>
        </div>
    </div>
    <div class="col-md-4">
        {% if resource.author|default(null) is not null %}
            {% include 'backend/topic/_author.html.twig' %}
        {% endif %}
    </div>
</div>

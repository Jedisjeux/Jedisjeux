{% import _self as self %}

{% macro updateStateButton(article, transition, icon, class) %}
    <form class="d-inline-block" action="{{ path('app_backend_article_update_state', {
        'id': article.id,
        'transition': transition
    }) }}" method="post">
        <input type="hidden" name="_method" value="PATCH">
        <button class="btn {{ class|default('btn-outline-primary') }}" type="submit">
            {{ ux_icon('tabler:' ~ icon, {'class': 'icon'}) }}
            {{ ('app.ui.'~transition)|trans }}
        </button>
    </form>
{% endmacro %}

{% if is_granted('ROLE_WORKFLOW') and article.status != constant('App\\Entity\\Article::STATUS_PUBLISHED') %}
    {% if state_machine.can('ask_for_review') %}
        {{ self.updateStateButton(article, 'ask_for_review', 'book') }}
    {% endif %}

    {% if state_machine.can('ask_for_publication') %}
        {{ self.updateStateButton(article, 'ask_for_publication', 'thumb-up') }}
    {% endif %}

    {% if state_machine.can('publish') %}
        {{ self.updateStateButton(article, 'publish', 'upload', 'btn-success') }}
    {% endif %}
{% endif %}

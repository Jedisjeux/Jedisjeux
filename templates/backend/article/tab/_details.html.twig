<div class="tab-pane active show" id="tab-details" role="tabpanel">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">{{ 'sylius.ui.details'|trans }}</h3>
        </div>
        <div class="card-body">
            {{ form_row(form.title) }}
            {{ form_row(form.mainTaxon) }}
            {{ form_row(form.mainImage) }}
            {{ form_row(form.shortDescription) }}
            {{ form_row(form.product) }}
        </div>
    </div>
</div>

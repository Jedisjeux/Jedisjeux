{% set steps = [
    {'status': constant('App\\Entity\\Article::STATUS_NEW'), 'label': 'sylius.ui.new'},
    {'status': constant('App\\Entity\\Article::STATUS_PENDING_REVIEW'), 'label': 'sylius.ui.pending_review'},
    {'status': constant('App\\Entity\\Article::STATUS_PENDING_PUBLICATION'), 'label': 'sylius.ui.pending_publication'},
    {'status': constant('App\\Entity\\Article::STATUS_PUBLISHED'), 'label': 'label.published'},
] %}

<ul class="steps steps-counter mb-4">
    {% for step in steps %}
        <li class="step-item{% if article.status == step.status %} active{% endif %}">{{ step.label|trans }}</li>
    {% endfor %}
</ul>

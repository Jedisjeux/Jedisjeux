<div class="tab-pane active show" id="tab-details" role="tabpanel">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">{{ 'sylius.ui.details'|trans }}</h3>
        </div>
        <div class="card-body">
            {{ form_row(form.code) }}
            {{ form_row(form.name) }}
            {{ form_row(form.image) }}
        </div>
    </div>
</div>

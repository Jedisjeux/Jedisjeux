{% extends 'backend/layout.html.twig' %}

{% block title %}{{ 'sylius.ui.dashboard'|trans }} | {{ parent() }}{% endblock %}

{% block header %}
    <div class="row g-2 align-items-center">
        <div class="col">
            <h2 class="page-title">
                {{ ux_icon('tabler:home', {'class': 'icon me-2'}) }}
                {{ 'sylius.ui.dashboard'|trans }}
            </h2>
            <div class="text-secondary mt-1">{{ 'app.ui.overview_of_your_website'|trans }}</div>
        </div>
    </div>
{% endblock %}

{% block content %}
    {{ component('Dashboard:Statistics') }}

    {% if is_granted('ROLE_ADMIN') %}
        <div class="row row-cards">
            <div class="col-lg-6">
                {{ render(url('sylius_backend_partial_customer_latest', {'count': 5, 'template': 'backend/dashboard/_customers.html.twig'})) }}
            </div>
            <div class="col-lg-6">
                {{ render(url('app_backend_partial_article_latest', {'count': 5, 'template': 'backend/dashboard/_articles.html.twig'})) }}
            </div>
        </div>
    {% elseif is_granted('ROLE_ARTICLE_MANAGER') %}
        {{ render(url('app_backend_partial_article_latest', {'count': 5, 'template': 'backend/dashboard/_articles.html.twig'})) }}
    {% endif %}
{% endblock %}

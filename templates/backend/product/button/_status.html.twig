{% import _self as self %}

{% macro updateStateButton(product, transition, icon, color) %}
    <form class="d-inline-block" action="{{ path('sylius_admin_product_' ~ transition, {'id': product.id}) }}" method="post">
        <input type="hidden" name="_method" value="PATCH">
        <button class="btn {{ color|default('') }}" type="submit">
            {{ ux_icon('tabler:' ~ icon, {'class': 'icon'}) }}
            {{ ('app.ui.'~transition)|trans }}
        </button>
    </form>
{% endmacro %}

{% if is_granted('ROLE_WORKFLOW') and product.status != constant('PUBLISHED', product) %}
    {% if sm_can(product, 'ask_for_translation', 'sylius_product') %}
        {{ self.updateStateButton(product, 'ask_for_translation', 'language') }}
    {% endif %}

    {% if sm_can(product, 'ask_for_review', 'sylius_product') %}
        {{ self.updateStateButton(product, 'ask_for_review', 'book') }}
    {% endif %}

    {% if sm_can(product, 'ask_for_publication', 'sylius_product') %}
        {{ self.updateStateButton(product, 'ask_for_publication', 'check') }}
    {% endif %}

    {% if sm_can(product, 'publish', 'sylius_product') %}
        {{ self.updateStateButton(product, 'publish', 'upload', 'btn-success') }}
    {% endif %}
{% endif %}

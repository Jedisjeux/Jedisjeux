{% extends 'knp_menu.html.twig' %}

{% block list %}
{% set form = (options.form) %}
<div class="row">
    <div class="col-md-3">
        <div class="list-group list-group-transparent mb-3" role="tablist">
            {% for item in item.children %}
                {{ block('item') }}
            {% endfor %}
        </div>
    </div>
    <div class="col-md-9">
        <div class="tab-content">
            {% for item in item.children %}
                {% include item.attribute('template') with {'form': form, 'product': options.product} %}
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}

{% block item %}
    <a href="#tab-{{ item.name }}" class="list-group-item list-group-item-action{% if item.actsLikeFirst %} active{% endif %}" data-bs-toggle="tab" role="tab">
        {{ item.label|trans }}
    </a>
{% endblock %}

<ul class="steps steps-counter mb-4">
    <li class="step-item{% if product.status == constant('STATUS_NEW', product) %} active{% endif %}">{{ 'sylius.ui.new'|trans }}</li>
    <li class="step-item{% if product.status == constant('PENDING_TRANSLATION', product) %} active{% endif %}">{{ 'sylius.ui.pending_translation'|trans }}</li>
    <li class="step-item{% if product.status == constant('PENDING_REVIEW', product) %} active{% endif %}">{{ 'sylius.ui.pending_review'|trans }}</li>
    <li class="step-item{% if product.status == constant('PENDING_PUBLICATION', product) %} active{% endif %}">{{ 'sylius.ui.pending_publication'|trans }}</li>
    <li class="step-item{% if product.status == constant('PUBLISHED', product) %} active{% endif %}">{{ 'sylius.ui.published'|trans }}</li>
</ul>

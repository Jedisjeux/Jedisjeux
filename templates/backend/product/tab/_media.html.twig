<div class="tab-pane" id="tab-media" role="tabpanel">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">{{ 'sylius.ui.media'|trans }}</h3>
        </div>
        <div class="card-body">
            <h4 class="mb-3">{{ 'sylius.ui.images'|trans }}</h4>
            {{ form_row(form.firstVariant.images) }}

            <h4 class="mb-3">{{ 'app.ui.videos'|trans }}</h4>
            {{ form_row(form.videos) }}
        </div>
    </div>
</div>

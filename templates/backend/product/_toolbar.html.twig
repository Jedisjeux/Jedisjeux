{% set product = resource %}

{% if product.slug %}
    <a class="btn" target="_blank" href="{{ path('sylius_frontend_product_show', {'slug': product.slug}) }}">
        {{ ux_icon('tabler:eye', {'class': 'icon'}) }}
        {{ 'app.ui.preview'|trans }}
    </a>
{% endif %}

{{ render(url('sylius_partial_product_status_show', {
    'id': product.id,
    'template': 'backend/product/button/_status.html.twig'
})) }}

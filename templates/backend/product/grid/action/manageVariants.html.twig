<div class="dropdown">
    <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
        {{ ux_icon('tabler:packages', {'class': 'icon'}) }}
        {{ 'sylius.ui.manage_variants'|trans }}
    </button>
    <div class="dropdown-menu dropdown-menu-end">
        <a class="dropdown-item" href="{{ path('sylius_backend_product_variant_index', { productId: data.id }) }}">
            {{ ux_icon('tabler:list', {'class': 'icon dropdown-item-icon'}) }}
            {{ 'sylius.ui.list_variants'|trans }}
        </a>
        <a class="dropdown-item" href="{{ path('sylius_backend_product_variant_create', { productId: data.id }) }}">
            {{ ux_icon('tabler:plus', {'class': 'icon dropdown-item-icon'}) }}
            {{ 'sylius.ui.add'|trans }}
        </a>
    </div>
</div>

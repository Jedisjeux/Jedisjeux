<div class="dropdown">
    <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
        {{ ux_icon('tabler:news', {'class': 'icon'}) }}
        {{ 'app.ui.manage_articles'|trans }}
    </button>
    <div class="dropdown-menu dropdown-menu-end">
        <a class="dropdown-item" href="{{ path('app_backend_article_per_product_index', { productId: data.id }) }}">
            {{ ux_icon('tabler:list', {'class': 'icon dropdown-item-icon'}) }}
            {{ 'app.ui.list_articles'|trans }}
        </a>
        <a class="dropdown-item" href="{{ path('app_backend_article_create_for_product', { productId: data.id }) }}">
            {{ ux_icon('tabler:plus', {'class': 'icon dropdown-item-icon'}) }}
            {{ 'app.ui.add_article'|trans }}
        </a>
        <a class="dropdown-item" href="{{ path('app_backend_article_create_for_product_review', { productId: data.id }) }}">
            {{ ux_icon('tabler:plus', {'class': 'icon dropdown-item-icon'}) }}
            {{ 'app.ui.add_review_article'|trans }}
        </a>
    </div>
</div>

<div class="tab-pane active show" id="tab-details" role="tabpanel">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">{{ 'sylius.ui.details'|trans }}</h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">{{ form_row(form.firstName) }}</div>
                <div class="col-md-6">{{ form_row(form.lastName) }}</div>
                <div class="col-md-6">{{ form_row(form.zone) }}</div>
                <div class="col-md-6">{{ form_row(form.website) }}</div>
            </div>
            {{ form_row(form.description) }}
        </div>
    </div>
</div>

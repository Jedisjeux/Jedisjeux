{% extends '@SyliusBootstrapAdminUi/shared/form_theme.html.twig' %}

{% block sylius_resource_autocomplete_choice_row %}
    <div class="mb-3 field position-relative{% if not valid %} is-invalid{% endif %}"
         data-app-autocomplete
         data-search-url="{{ search_url|default('') }}"
         data-init-url="{{ init_load_url|default('') }}"
         data-create-url="{{ create_url|default('') }}"
         data-choice-name="{{ choice_name }}"
         data-choice-value="{{ choice_value }}"
         data-multiple="{{ multiple ? 1 : 0 }}"
    >
        {{- form_label(form) -}}
        <div class="d-flex flex-wrap gap-1 mb-1" data-autocomplete="selection"></div>
        <input type="search" class="form-control" autocomplete="off" data-autocomplete="search"
               placeholder="{{ placeholder|default('sylius.ui.start_typing_to_search')|trans }}"{% if disabled %} disabled{% endif %}>
        <div class="dropdown-menu w-100" data-autocomplete="results"></div>
        {{ form_widget(form) }}
        {{- form_errors(form) -}}
    </div>
{% endblock %}

{% block sylius_taxon_autocomplete_choice_row %}
    {{ form_row(form, {'search_url': path('sylius_admin_ajax_taxon_by_name_phrase'), 'init_load_url': path('sylius_admin_ajax_taxon_by_code')}) }}
{% endblock %}

{% block sylius_product_autocomplete_choice_row %}
    {{ form_row(form, {'search_url': path('sylius_admin_ajax_product_by_name_phrase'), 'init_load_url': path('sylius_admin_ajax_product_by_code')}) }}
{% endblock %}

{% block app_person_autocomplete_choice_row %}
    {{ form_row(form, {'search_url': path('app_admin_ajax_person_by_name_phrase'), 'init_load_url': path('app_admin_ajax_person_by_id'), 'create_url': path('app_admin_ajax_person_create')}) }}
{% endblock %}

{%- block collection_widget -%}
    <div data-form-type="collection" {{ block('widget_container_attributes') }}>
        {{ form_errors(form) }}

        <div data-form-collection="list">
            {% for child in form %}
                {{ _self.collection_item(child, allow_delete, button_delete_label|default('sylius.ui.delete'), loop.index0) }}
            {% endfor %}
        </div>

        {% if prototype is defined and allow_add %}
            <template data-form-collection="prototype" data-prototype-name="{{ prototype.vars.name }}">
                {{ _self.collection_item(prototype, allow_delete, button_delete_label|default('sylius.ui.delete'), prototype.vars.name) }}
            </template>
            <button type="button" class="btn btn-outline-primary mb-3" data-form-collection="add">
                {{ ux_icon('tabler:plus') }}
                {{ button_add_label|default('sylius.ui.add')|trans }}
            </button>
        {% endif %}
    </div>
{%- endblock collection_widget -%}

{% macro collection_item(form, allow_delete, button_delete_label, index) %}
    <div class="card mb-3" data-form-collection="item" data-form-collection-index="{{ index }}">
        <div class="card-body">
            {{ form_widget(form) }}
            {{ form_errors(form) }}
        </div>
        {% if allow_delete %}
            <div class="card-footer text-end">
                <button type="button" class="btn btn-outline-danger" data-form-collection="delete">
                    {{ ux_icon('tabler:trash') }}
                    {{ button_delete_label|trans }}
                </button>
            </div>
        {% endif %}
    </div>
{% endmacro %}

{% block infinite_form_polycollection_row -%}
    <div data-form-type="collection" {{ block('widget_container_attributes') }}>
        <div data-form-collection="list">
            {% for child in form %}
                {{ _self.collection_item(child, allow_delete, button_delete_label|default('sylius.ui.delete'), loop.index0) }}
            {% endfor %}
        </div>

        <div class="dropdown mb-3">
            <button type="button" class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                {{ ux_icon('tabler:plus') }}
                {{ 'sylius.ui.add'|trans }}
            </button>
            <div class="dropdown-menu">
                <h6 class="dropdown-header">{{ 'sylius.ui.type'|trans }}</h6>
                {% for key, prototype in prototypes %}
                    <template data-form-collection="prototype" data-prototype-name="{{ prototype.vars.name }}" data-prototype-key="{{ key }}">
                        {{ _self.collection_item(prototype, allow_delete, button_delete_label|default('sylius.ui.delete'), prototype.vars.name) }}
                    </template>
                    <a class="dropdown-item" href="#" data-form-collection="add" data-prototype-key="{{ key }}">
                        {{ prototype.vars.label|default(key)|trans }}
                    </a>
                {% endfor %}
            </div>
        </div>
    </div>
{%- endblock %}

{% block app_image_widget %}
    {{ form_row(form.type) }}
    {% if form.vars.value.path|default(null) is not null %}
        <img class="img-thumbnail mb-2" src="{{ form.vars.value.path|imagine_filter('product_box') }}" alt="{{ form.vars.value.type }}" />
    {% endif %}
    {{ form_row(form.file) }}
{% endblock %}

{% block app_date_time_picker_widget %}
    {% set attr = attr|merge({'placeholder': 'jj/mm/aaaa hh:mm'}) %}
    {{ block('form_widget_simple') }}
{% endblock %}

{% block single_image_block_widget %}
    {% import _self as self %}

    {% set imagePosition = form.imagePosition.vars.data %}

    <div class="d-flex justify-content-end gap-2 mb-3">
        <a class="btn btn-sm app-move-up" href="#">
            {{ ux_icon('tabler:arrow-up') }}
            {{ 'app.ui.move_up'|trans }}
        </a>
        <a class="btn btn-sm app-move-down" href="#">
            {{ ux_icon('tabler:arrow-down') }}
            {{ 'app.ui.move_down'|trans }}
        </a>
    </div>

    {% if 'left' == imagePosition %}
        {{ self.single_image_left(form) }}
    {% elseif 'right' == imagePosition %}
        {{ self.single_image_right(form) }}
    {% elseif 'top' == imagePosition %}
        {{ self.single_image_top(form) }}
    {% else %}
        {{ form_rest(form) }}
    {% endif %}
{% endblock %}

{% macro single_image_left(form) %}
    <div class="row">
        <div class="col-md-4">
            {{ form_row(form.imagePosition) }}

            {% set image = form.image %}

            {% if image.vars.data and image.vars.data.webPath %}
                <img class="img-fluid mb-2" src="{{ image.vars.data.webPath | imagine_filter('magazine_item') }}"/>
            {% endif %}

            {{ form_row(form.image.file) }}
            {{ form_row(form.image.label) }}
        </div>
        <div class="col-md-8">
            {{ form_row(form.title) }}
            {{ form_row(form.body) }}
            {{ form_row(form.class) }}
            {{ form_row(form.product) }}
        </div>
    </div>

    {{ form_row(form.position) }}
{% endmacro %}

{% macro single_image_right(form) %}
    <div class="row">
        <div class="col-md-8">
            {{ form_row(form.title) }}
            {{ form_row(form.body) }}
            {{ form_row(form.class) }}
            {{ form_row(form.product) }}
        </div>
        <div class="col-md-4">
            {{ form_row(form.imagePosition) }}

            {% set image = form.image %}

            {% if image.vars.data and image.vars.data.webPath %}
                <img class="img-fluid mb-2" src="{{ image.vars.data.webPath | imagine_filter('magazine_item') }}"/>
            {% endif %}
            {{ form_row(form.image.file) }}
            {{ form_row(form.image.label) }}
        </div>
    </div>
    {{ form_row(form.position) }}
{% endmacro %}

{% macro single_image_top(form) -%}
    {{ form_row(form.title) }}
    {% set image = form.image.vars.data %}

    <div class="row">
        {% if image and image.webPath %}
            <div class="col-md-3">
                <img class="img-fluid" src="{{ image.webPath | imagine_filter('magazine_item') }}"/>
            </div>
        {% endif %}
        <div class="col">
            {{ form_row(form.imagePosition) }}
            {{ form_row(form.image.file) }}
            {{ form_row(form.image.label) }}
        </div>
    </div>
    {{ form_row(form.body) }}
    {{ form_row(form.class) }}
    {{ form_row(form.product) }}
    {{ form_row(form.position) }}
{%- endmacro %}

{% macro image_with_thumbnail(form, filter) %}
    {% import 'macro/image.html.twig' as images %}

    {% set image = form.vars.value %}

    <div class="row" id="{{ form.vars.id }}">
        {% if image and image.webPath %}
            <div class="col-md-3">
                {{ images.render(image.webPath, filter, null, 'img-thumbnail') }}
            </div>
        {% endif %}
        <div class="col">
            {{ form_rest(form) }}
        </div>
    </div>
{% endmacro %}

{% block app_dealer_image_widget %}
    {{ _self.image_with_thumbnail(form, null) }}
{% endblock %}

{% block app_product_variant_image_widget %}
    {{ _self.image_with_thumbnail(form, null) }}
{% endblock %}

{% block app_article_image_widget %}
    {{ _self.image_with_thumbnail(form, null) }}
{% endblock %}

{% block app_product_box_image_widget %}
    {{ _self.image_with_thumbnail(form, 'product_box') }}
{% endblock %}

{% block app_game_award_image_widget %}
    {{ _self.image_with_thumbnail(form, null) }}
{% endblock %}

{% block _app_product_file_widget %}
    {{ form_row(form.title) }}

    {% set file = form.vars.value %}

    <div id="app_product_file">
        {% if file and file.path %}
            <a target="_blank" href="{{ vich_uploader_asset(file, 'file') }}" class="btn mb-2">
                {{ ux_icon('tabler:eye') }}
                {{ 'sylius.ui.show'|trans }}
            </a>
        {% endif %}
        {{ form_row(form.file) }}
    </div>
{% endblock %}

{% block _app_customer_user_roles_widget %}
    {% set roles = [] %}
    {% for child in form %}
        {% set roles = roles|merge({(child.vars.value): child}) %}
    {% endfor %}

    <div class="row">
        {% for choiceGroup in form.vars.choices %}
            <div class="col-md-4">
                <div class="card mb-3">
                    <div class="card-header"><h3 class="card-title">{{ choiceGroup.label|trans }}</h3></div>
                    <div class="card-body">
                        {% for choice in choiceGroup.choices %}
                            {{ form_row(roles[choice.value]) }}
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}

{# The sylius-validation-error class is what the Behat pages look for #}
{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        {%- for error in errors -%}
            <div class="invalid-feedback d-block sylius-validation-error">{{ error.message }}</div>
        {%- endfor -%}
    {%- endif -%}
{%- endblock form_errors -%}

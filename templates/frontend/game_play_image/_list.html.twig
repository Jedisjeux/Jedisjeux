{% import 'macro/image.html.twig' as images %}
{% import 'macro/messages.html.twig' as messages %}

{% for image in game_play_images %}
    {% set game_play = image.gamePlay %}
    {% if game_play is not null and game_play.product is not null %}
        {% set gamePlayPath = path('app_frontend_game_play_show', {'productSlug': game_play.product.slug, 'id': game_play.id}) %}
        <article class="editorial-photo-card">
            <a class="editorial-photo-card__image" href="{{ gamePlayPath }}" aria-label="Voir la partie de {{ game_play.product.name }}">
                {{ images.render(image.webPath, 'magazine_item_wide', image.description|default(game_play.product.name)) }}
                <span class="editorial-photo-card__open"><i class="fa fa-link" aria-hidden="true"></i></span>
            </a>
            <div class="editorial-photo-card__caption">
                {% if image.description is not empty %}<p class="editorial-photo-card__description">{{ image.description }}</p>{% endif %}
                <h2><a href="{{ gamePlayPath }}">{{ game_play.product.name }}</a></h2>
                <p class="editorial-photo-card__meta">
                    <span><i class="fa fa-user" aria-hidden="true"></i> {{ game_play.author }}</span>
                    <time><i class="fa fa-calendar-o" aria-hidden="true"></i> {{ game_play.createdAt|format_datetime('medium', 'none') }}</time>
                </p>
            </div>
        </article>
    {% endif %}
{% else %}
    <div class="editorial-photo-gallery__empty">{{ messages.info('app.ui.there_are_no_game_plays') }}</div>
{% endfor %}

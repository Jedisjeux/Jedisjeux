{% if product_lists|length > 0 %}
    <div class="editorial-list-grid">
        {% for product_list in product_lists %}
            {% include 'frontend/product_list/_single.html.twig' %}
        {% endfor %}
    </div>
{% else %}
    <div class="editorial-list-empty">
        <i class="fa fa-list" aria-hidden="true"></i>
        <p>Aucune liste de jeux pour le moment.</p>
    </div>
{% endif %}

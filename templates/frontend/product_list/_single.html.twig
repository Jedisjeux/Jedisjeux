{% import 'macro/image.html.twig' as images %}

{% set lastProduct = product_list.lastProduct %}
{% set productListPath = path(targetPath|default('app_frontend_product_list_item_index'), {'productListSlug': product_list.slug}) %}

<article class="editorial-list-card">
    <a href="{{ productListPath }}" class="editorial-list-card__image" tabindex="-1" aria-hidden="true">
        {% if lastProduct and lastProduct.mainImage %}
            {{ images.fit(lastProduct.mainImage.webPath, product_list.name) }}
        {% else %}
            <span class="editorial-list-card__placeholder"><i class="fa fa-cubes"></i></span>
        {% endif %}
        <span class="editorial-list-card__count">{{ product_list.items|length }} {{ 'app.ui.games'|trans|lower }}</span>
    </a>
    <div class="editorial-list-card__body">
        <h2><a href="{{ productListPath }}">{{ product_list.name }}</a></h2>
        <p class="editorial-list-card__meta"><i class="fa fa-calendar-o" aria-hidden="true"></i> {{ product_list.createdAt|format_datetime('medium', 'none') }}</p>
        <a href="{{ productListPath }}" class="editorial-list-card__link">{{ 'sylius.ui.view_more'|trans }} <i class="fa fa-arrow-right" aria-hidden="true"></i></a>
    </div>
</article>

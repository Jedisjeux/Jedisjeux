{% extends 'frontend/layout.html.twig' %}

{% set pageTitle = 'sylius.ui.login'|trans %}

{% block content %}
    <div class="breadcrumb-container">
        <div class="container">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><i class="fa fa-home pr-2"></i><a class="link-dark" href="{{ path('app_homepage') }}">{{ 'sylius.ui.home'|trans }}</a></li>
                <li class="breadcrumb-item active">{{ pageTitle }}</li>
            </ol>
        </div>
    </div>

    <div class="editorial-catalog editorial-login">
        <section class="editorial-catalog__intro">
            <div class="container">
                <span class="editorial-eyebrow">La communauté · Heureux de vous revoir</span>
                <h1>{{ pageTitle }}</h1>
                <p>Retrouvez vos échanges et vos parties sur Jedisjeux.</p>
            </div>
        </section>
    </div>

    <section class="editorial-login-main">
        <div class="container">
            <div class="editorial-login__layout">
                <aside class="editorial-login__welcome">
                    <span class="editorial-eyebrow">Reprenez votre place</span>
                    <h2>La table vous attend.</h2>
                    <p>Connectez-vous pour retrouver les discussions et les moments de jeu partagés par la communauté.</p>
                    <div class="editorial-login__note"><i class="fa fa-shield" aria-hidden="true"></i><span>Votre compte Jedisjeux vous accompagne dans toutes vos découvertes ludiques.</span></div>
                </aside>
                <div class="editorial-login__panel">
                    <h2>{{ pageTitle }}</h2>
                    <p class="editorial-login__hint">Entrez vos identifiants pour continuer.</p>

                    {% form_theme form 'frontend/form/horizontal.html.twig' %}
                    <form class="form-horizontal" action="{{ path('sylius_frontend_login_check') }}" method="post">
                        {% if error %}
                            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                        {% endif %}
                        {{ form_errors(form) }}

                        {{ form_row(form._username, {attr: {'placeholder': 'app.ui.username_or_email'}}) }}
                        {{ form_row(form._password, {attr: {'placeholder': 'sylius.form.login.password'}}) }}

                        <div class="editorial-login__options">
                            <label class="editorial-login__remember" for="remember-me">
                                <input type="checkbox" id="remember-me" name="_remember_me" value="on">
                                <span>{{ 'sylius.form.login.remember_me'|trans }}</span>
                            </label>
                            <a href="{{ path('sylius_user_request_password_reset_token') }}">{{ 'sylius.ui.forgot_password'|trans }}</a>
                        </div>

                        <input type="hidden" name="_csrf_shop_security_token" value="{{ csrf_token('shop_authenticate') }}">
                        {{ form_rest(form, {'render_rest': false}) }}
                        <button id="_login" type="submit" class="editorial-login__submit">{{ 'sylius.ui.login_button'|trans }} <i class="fa fa-arrow-right" aria-hidden="true"></i></button>
                    </form>
                    <p class="editorial-login__register">{{ 'app.ui.do_not_have_an_account_yet'|trans }} <a href="{{ path('app_frontend_register') }}">{{ 'sylius.ui.register'|trans }}</a></p>
                </div>
            </div>
        </div>
    </section>

    {% include 'frontend/footer/_top.html.twig' %}
{% endblock content %}

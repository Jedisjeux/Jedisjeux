{% extends 'frontend/layout.html.twig' %}

{% set pageTitle = 'app.ui.new_topic'|trans %}

{% block content %}
    {% embed 'frontend/post/_compose.html.twig' with {
        eyebrow: 'Forum · Nouveau sujet',
        lead: 'Lancez une discussion avec la communauté : une question, une découverte, un compte-rendu…',
        breadcrumb: [{label: 'app.ui.forum'|trans, url: path('app_frontend_topic_index')}],
        tips: ['Vérifiez qu’un sujet proche n’existe pas déjà.', 'Choisissez la catégorie qui correspond le mieux.', 'Un titre clair aide la communauté à vous répondre.'],
    } %}
        {% block fields %}
            <div class="editorial-compose__grid">
                {{ form_row(form.title, {attr: {placeholder: 'De quoi voulez-vous parler ?'}}) }}
                {{ form_row(form.mainTaxon) }}
            </div>
            {{ form_row(form.mainPost.body, {label: 'sylius.ui.message'|trans}) }}
        {% endblock %}
    {% endembed %}
{% endblock content %}

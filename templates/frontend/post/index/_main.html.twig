{% import 'macro/buttons.html.twig' as buttons %}
{% from 'macro/pagination.html.twig' import simple as pagination %}

{% set replyCount = topic.posts|length %}

<main class="main col-lg-8 editorial-thread-main">
    {% if app.user and topic.author.id == app.user.customer.id %}
        <div class="editorial-thread-controls">
            <a class="editorial-thread-controls__edit" title="Modifier le sujet" href="{{ path('app_frontend_topic_update', {'id': topic.id}) }}"><i class="fa fa-pencil" aria-hidden="true"></i> Modifier</a>
            <form action="{{ path('app_frontend_topic_delete', {'id': topic.id}) }}" method="post">
                <input type="hidden" name="_method" value="DELETE">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token(topic.id) }}">
                <button class="editorial-thread-controls__delete btn-confirm" type="submit" title="{{ 'label.delete'|trans }}"><i class="fa fa-trash-o" aria-hidden="true"></i></button>
            </form>
        </div>
    {% endif %}

    <header class="editorial-thread-heading">
        <span class="editorial-eyebrow">Le forum{% if topic.mainTaxon is not null %} · {{ topic.mainTaxon }}{% endif %}</span>
        <h1>{{ topic.title }}</h1>
        <div class="editorial-thread-meta">
            <span><i class="fa fa-user-o" aria-hidden="true"></i> {{ topic.author }}</span>
            <span><i class="fa fa-calendar-o" aria-hidden="true"></i> {{ topic.createdAt|format_datetime('medium', 'none') }}</span>
            <span><i class="fa fa-comments-o" aria-hidden="true"></i> {{ replyCount }} réponse{% if replyCount != 1 %}s{% endif %}</span>
        </div>
    </header>

    <article class="editorial-thread-opening">
        <div class="editorial-thread-opening__body">
            {% if topic.mainPost is not null %}
                {{ topic.mainPost.body|raw }}
            {% else %}
                <p class="editorial-thread-opening__empty">Le sujet n’a pas de message d’ouverture. Vous pouvez poursuivre la discussion ci-dessous.</p>
            {% endif %}
        </div>
        {% if topic.mainTaxon is not null %}
            <footer><span class="editorial-thread-tag"><i class="fa fa-tag" aria-hidden="true"></i> {{ topic.mainTaxon }}</span></footer>
        {% endif %}
    </article>

    <div class="editorial-thread-reply">
        {{ buttons.btn(path('app_frontend_post_create_by_topic', {'topicId': topic.id}), 'Répondre au sujet', null, 'reply', 'btn-default btn-lg') }}
    </div>

    <section class="editorial-thread-replies">
        <header class="editorial-thread-replies__heading">
            <div>
                <span class="editorial-eyebrow">La discussion</span>
                <h2>Réponses</h2>
            </div>
            <span class="editorial-thread-replies__count">{{ replyCount }}</span>
        </header>
        <div id="comments" class="comments editorial-thread-comments">
            {% include 'frontend/post/index/_comments.html.twig' %}
        </div>
        {{ pagination(posts) }}
    </section>
</main>

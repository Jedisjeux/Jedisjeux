{% extends 'frontend/layout.html.twig' %}
{% import 'macro/page_views.html.twig' as page_views %}

{% set pageTitle %}
    {{ topic.title }}
{% endset %}

{% block content %}
    {% include 'frontend/post/index/_breadcrumb.html.twig' %}

    <!-- main-container start -->
    <!-- ================ -->
    <section class="main-container editorial-discussion-page">

        <div class="container">
            <div class="row">
                {% include 'frontend/post/index/_main.html.twig' %}
                {% include 'frontend/post/index/_sidebar.html.twig' %}
            </div>
        </div>
    </section>
    <!-- main-container end -->

    {% include 'frontend/post/index/_footerTop.html.twig' %}
    {{ page_views.render(topic.id, 'topics') }}
{% endblock content %}

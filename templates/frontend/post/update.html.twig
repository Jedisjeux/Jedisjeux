{% extends 'frontend/layout.html.twig' %}

{% set pageTitle = 'app.ui.edit_post'|trans %}

{% block content %}
    {% set topic = resource.topic %}
    {% embed 'frontend/post/_compose.html.twig' with {
        eyebrow: 'Forum · ' ~ topic.title,
        lead: 'Corrigez ou complétez votre message.',
        breadcrumb: [{label: 'app.ui.forum'|trans, url: path('app_frontend_topic_index')}, {label: topic.title, url: path('app_frontend_post_index_by_topic', {topicId: topic.id})}],
        context: {label: 'Vous répondez à', title: topic.title, url: path('app_frontend_post_index_by_topic', {topicId: topic.id})},
        tips: ['Restez courtois, même en cas de désaccord.', 'Restez dans le sujet de la discussion.', 'Relisez-vous avant de publier.'],
        update: true,
    } %}
        {% block fields %}
            {{ form_row(form.body, {label: 'sylius.ui.message'|trans}) }}
        {% endblock %}
    {% endembed %}
{% endblock content %}

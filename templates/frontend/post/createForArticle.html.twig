{% extends 'frontend/layout.html.twig' %}

{% set pageTitle = 'app.ui.your_comment'|trans %}

{% block content %}
    {% set article = resource.article %}
    {% embed 'frontend/post/_compose.html.twig' with {
        eyebrow: 'Articles · ' ~ article.title,
        lead: 'Donnez votre avis sur cet article.',
        breadcrumb: [{label: 'app.ui.articles'|trans, url: path('app_frontend_article_index')}, {label: article.title, url: path('app_frontend_article_show', {slug: article.slug})}],
        context: {label: 'Vous commentez l’article', title: article.title, url: path('app_frontend_article_show', {slug: article.slug})},
        tips: ['Restez courtois, même en cas de désaccord.', 'Partagez votre avis ou votre expérience du jeu.', 'Relisez-vous avant de publier.'],
    } %}
        {% block fields %}
            {{ form_row(form.body, {label: 'sylius.ui.message'|trans}) }}
        {% endblock %}
    {% endembed %}
{% endblock content %}

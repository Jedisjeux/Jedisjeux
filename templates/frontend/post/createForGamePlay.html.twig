{% extends 'frontend/layout.html.twig' %}

{% set pageTitle = 'app.ui.your_comment'|trans %}

{% block content %}
    {% set gamePlay = resource.gamePlay %}
    {% set gamePlayUrl = path('app_frontend_game_play_show', {productSlug: gamePlay.product.slug, id: gamePlay.id}) %}
    {% embed 'frontend/post/_compose.html.twig' with {
        eyebrow: 'Parties · ' ~ gamePlay.product.name,
        lead: 'Réagissez à cette partie : un conseil, une question, un souvenir…',
        breadcrumb: [{label: 'app.ui.game_plays'|trans, url: path('app_frontend_game_play_index')}, {label: gamePlay.product.name, url: gamePlayUrl}],
        context: {label: 'Vous commentez la partie de', title: gamePlay.product.name, url: gamePlayUrl},
        tips: ['Restez courtois, même en cas de désaccord.', 'Partagez votre avis ou votre expérience du jeu.', 'Relisez-vous avant de publier.'],
    } %}
        {% block fields %}
            {{ form_row(form.body, {label: 'sylius.ui.message'|trans}) }}
        {% endblock %}
    {% endembed %}
{% endblock content %}

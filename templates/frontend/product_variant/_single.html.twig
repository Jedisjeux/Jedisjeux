{% import 'macro/image.html.twig' as images %}
{% from 'macro/product.html.twig' import releasedAt %}

{% import _self as self %}

{% macro show_people(people) %}
    {% for person in people %}{% apply spaceless %}
        {% if not loop.first %}, {% endif %}<a href="{{ path('sylius_frontend_product_index_by_person', { 'slug': person.slug } ) }}">{{ person }}</a>
    {% endapply %}{% endfor %}
{% endmacro %}

<article class="editorial-catalog-card editorial-variant-card">
    <div class="editorial-catalog-card__image">
        {% if product_variant.mainImage is not null %}
            {{ images.render(product_variant.mainImage.webPath, 'magazine_item', product_variant.name) }}
        {% elseif product.mainImage is not null %}
            {{ images.render(product.mainImage.webPath, 'magazine_item', product.name) }}
        {% endif %}
    </div>
    <div class="editorial-catalog-card__body">
        <h2>{{ product_variant.name }}</h2>
        <dl class="editorial-variant-card__people">
            {% if product_variant.designers|length > 0 %}
                <dt>Auteur(s)</dt><dd>{{ self.show_people(product_variant.designers) }}</dd>
            {% endif %}
            {% if product_variant.artists|length > 0 %}
                <dt>Illustrateur(s)</dt><dd>{{ self.show_people(product_variant.artists) }}</dd>
            {% endif %}
            {% if product_variant.publishers|length > 0 %}
                <dt>Editeur(s)</dt><dd>{{ self.show_people(product_variant.publishers) }}</dd>
            {% endif %}
        </dl>
        <div class="editorial-catalog-card__release">Sortie : {{ releasedAt(product_variant) }}</div>
    </div>
</article>

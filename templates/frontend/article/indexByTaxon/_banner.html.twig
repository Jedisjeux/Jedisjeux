<div class="editorial-catalog editorial-magazine">
    {% include 'frontend/article/index/_breadcrumb.html.twig' %}
    <section class="editorial-catalog__intro">
        <div class="container">
            <span class="editorial-eyebrow">Le magazine · {{ taxon.name }}</span>
            <h1>{{ 'app.ui.articles'|trans }}</h1>
            {% if taxon.description is not empty %}<div class="editorial-catalog__description">{{ taxon.description|raw }}</div>{% endif %}
        </div>
    </section>
    <div class="editorial-catalog__filters">
        {% include 'frontend/article/index/_filters.html.twig' %}
    </div>
</div>

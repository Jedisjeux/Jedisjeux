{% import 'macro/image.html.twig' as images %}

{% if article.reviews|length > 0 %}
    <section class="editorial-article-reviews">
        <span class="editorial-eyebrow">Avis de la rédaction</span>
        <h2>Ce qu’en pense l’équipe</h2>
        {% for review in article.reviews %}
            {% set avatarPath = review.author.avatar is not null ? review.author.avatar.webPath : '/assets/frontend/images/avatar-placeholder.png' %}
            <div class="editorial-article-review">
                <div class="editorial-article-review__avatar">{{ images.render(avatarPath, 'thumbnail', review.author, 'rounded-circle') }}</div>
                <div class="editorial-article-review__body">
                    <header>
                        <strong>{{ review.author }}</strong>
                        <span class="editorial-article-review__score"><i class="fa fa-star" aria-hidden="true"></i>{{ review.rating }}<small>/10</small></span>
                    </header>
                    <div class="editorial-article-review__text">{{ review.comment|raw }}</div>
                </div>
            </div>
        {% endfor %}
    </section>
{% endif %}

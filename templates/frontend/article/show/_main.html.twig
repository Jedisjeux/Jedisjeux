{% from 'macro/icon.html.twig' import icon %}
{% import _self as self %}

{% macro show_block(block) %}
    {% import _self as self %}

    <section class="editorial-article-block">
        {% if block.title is not null %}
            <h2>{{ block.title }}</h2>
        {% endif %}
        {% if block.image is not null %}
            {{ self.show_block_image(block.image, block.imagePosition) }}
        {% endif %}
        {{ block.body|raw }}
        {% if block.product is not null %}
            {{ self.show_block_product(block.product) }}
        {% endif %}
    </section>
{% endmacro %}

{% macro show_block_product(product) %}
    {% from 'macro/icon.html.twig' import icon %}
    {% from 'macro/product.html.twig' import duration, playerCount %}

    {% set productPath = path('sylius_frontend_product_show', {'slug': product.slug}) %}

    <aside class="editorial-block-game" aria-label="Le jeu : {{ product.name }}">
        <a class="editorial-block-game__name" href="{{ productPath }}">{{ icon('dice') }}{{ product.name }}</a>
        {% if product.minPlayerCount or product.minAge or product.minDuration %}
            <ul class="editorial-block-game__facts">
                {% if product.minPlayerCount %}<li>{{ icon('user') }}{{ playerCount(product) }}</li>{% endif %}
                {% if product.minAge %}<li>{{ icon('age') }}{{ product.minAge }}+</li>{% endif %}
                {% if product.minDuration %}<li>{{ icon('clock') }}{{ duration(product) }}</li>{% endif %}
            </ul>
        {% endif %}
        <a class="editorial-block-game__link" href="{{ productPath }}">Voir la fiche{{ icon('arrow-right') }}</a>
    </aside>
{% endmacro %}

{% macro show_block_image(image, position) %}
    {% import 'macro/image.html.twig' as images %}

    {% set positionClass = 'editorial-article-figure--full' %}

    {% if position is constant('App\\Entity\\Block::POSITION_LEFT') %}
        {% set positionClass = 'editorial-article-figure--left' %}
    {% elseif position is constant('App\\Entity\\Block::POSITION_RIGHT') %}
        {% set positionClass = 'editorial-article-figure--right' %}
    {% endif %}

    <figure class="editorial-article-figure {{ positionClass }}">
        <a class="popup-img" href="{{ image.webPath|imagine_filter('full') }}" title="{{ image.label }}">
            {{ images.render(image.webPath, 'full', image.label) }}
            <span class="editorial-article-figure__zoom" aria-hidden="true"><i class="fa fa-search-plus" aria-hidden="true">{{ ux_icon('fa:search-plus', {class: 'fa-svg'}) }}</i></span>
        </a>
        {% if image.label %}<figcaption>{{ image.label }}</figcaption>{% endif %}
    </figure>
{% endmacro %}

<section class="main-container editorial-article-main">
    <div class="container">
        <div class="editorial-article-layout">
            <article class="editorial-article-body">
                {% if article.shortDescription %}
                    <div class="editorial-article-lead">{{ article.shortDescription|raw }}</div>
                {% endif %}

                {% for block in article.blocks %}
                    {{ self.show_block(block) }}
                {% endfor %}

                {% if article.mainTaxon is not null %}
                    <footer class="editorial-article-footer">
                        <span>Publié dans</span>
                        <a href="{{ path('app_frontend_article_index_by_taxon', {'slug': article.mainTaxon.slug}) }}">{{ icon('tag') }}{{ article.mainTaxon.name }}</a>
                    </footer>
                {% endif %}

                {% include 'frontend/article/show/_reviews.html.twig' %}
            </article>

            {% include 'frontend/article/show/_sidebar.html.twig' %}
        </div>
    </div>
</section>

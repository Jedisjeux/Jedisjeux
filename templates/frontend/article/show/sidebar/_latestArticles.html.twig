{% if currentTaxon is null %}
    {% set latestTitle = 'Derniers articles' %}
{% elseif currentTaxon.code is constant('App\\Entity\\Taxon::CODE_NEWS') %}
    {% set latestTitle = 'app.ui.latest_news'|trans %}
{% elseif currentTaxon.code is constant('App\\Entity\\Taxon::CODE_REVIEW_ARTICLE') %}
    {% set latestTitle = 'app.ui.latest_reviews'|trans %}
{% elseif currentTaxon.code is constant('App\\Entity\\Taxon::CODE_VIDEO') %}
    {% set latestTitle = 'app.ui.latest_videos'|trans %}
{% elseif currentTaxon.code is constant('App\\Entity\\Taxon::CODE_IN_THE_BOXES') %}
    {% set latestTitle = 'app.ui.latest_in_the_boxes'|trans %}
{% else %}
    {% set latestTitle = currentTaxon.name %}
{% endif %}
{% set articlesPath = currentTaxon is not null ? path('app_frontend_article_index_by_taxon', { 'slug': currentTaxon.slug }) : path('app_frontend_article_index') %}

<section id="latest-articles" class="editorial-sidebar-card">
    <span class="editorial-eyebrow">{{ latestTitle }}</span>
    {{ component('Article:LatestList', {count: 4, taxon: currentTaxon}) }}
    <a href="{{ articlesPath }}" class="editorial-sidebar-card__more">{{ 'app.ui.more'|trans }} <i class="fa fa-arrow-right" aria-hidden="true">{{ ux_icon('fa:arrow-right', {class: 'fa-svg'}) }}</i></a>
</section>

{% if article.averageRating > 0 %}
    {% set criteria = [
        {'label': 'Matériel', 'value': article.materialRating},
        {'label': 'Règles', 'value': article.rulesRating},
        {'label': 'Durée de vie', 'value': article.lifetimeRating}
    ] %}

    <section class="editorial-sidebar-card editorial-article-score">
        <span class="editorial-eyebrow">La note de la rédaction</span>
        <div class="editorial-article-score__value">
            <strong>{{ article.averageRating|round(1) }}</strong><small>/10</small>
        </div>
        <ul>
            {% for criterion in criteria if criterion.value > 0 %}
                <li>
                    <span>{{ criterion.label }}</span>
                    <span class="editorial-article-score__bar" aria-hidden="true"><span style="width: {{ criterion.value * 20 }}%"></span></span>
                    <strong>{{ criterion.value }}/5</strong>
                </li>
            {% endfor %}
        </ul>
    </section>
{% endif %}

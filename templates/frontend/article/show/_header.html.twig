{% from 'macro/icon.html.twig' import icon %}
{% import 'macro/image.html.twig' as images %}

{% set commentCount = article.topic is not null ? article.topic.postCount : 0 %}

<header class="editorial-article-header">
    <div class="container">
        <div class="editorial-article-header__intro">
            {% if article.mainTaxon is not null %}
                <a class="editorial-eyebrow" href="{{ path('app_frontend_article_index_by_taxon', {'slug': article.mainTaxon.slug}) }}">{{ article.mainTaxon.name }}</a>
            {% else %}
                <span class="editorial-eyebrow">Le magazine</span>
            {% endif %}
            <h1>{{ article.title }}</h1>
            <ul class="editorial-article-meta">
                <li>{{ icon('user') }}Par <strong>{{ article.author }}</strong></li>
                <li>{{ icon('calendar') }}{{ article.publishStartDate|localizeddate('long', 'none') }}</li>
                <li><a href="#comments">{{ icon('message') }}{{ commentCount }} {{ commentCount > 1 ? 'réactions' : 'réaction' }}</a></li>
            </ul>
        </div>
        {% if article.mainImage is not null %}
            <figure class="editorial-article-header__image">
                {{ images.fit(article.mainImage.webPath, article.title, 'full', 'editorial-image-fit--natural', true) }}
            </figure>
        {% endif %}
    </div>
</header>

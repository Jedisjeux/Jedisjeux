{% macro renderNotification(id, message, targetUrl, imagePath) %}
    <li class="notificationItem">
        <a data-id="{{ id }}" data-target="{{ targetUrl }}" href="#" class="notificationItem__avatar" tabindex="-1" aria-hidden="true">
            <img src="{{ imagePath }}" alt="">
        </a>
        <a data-id="{{ id }}" data-target="{{ targetUrl }}" href="#" class="notificationItem__message">
            <span>{{ message }}</span>
            <small>Ouvrir <i class="fa fa-arrow-right" aria-hidden="true"></i></small>
        </a>
    </li>
{% endmacro %}

<div class="btn-group notificationBlock">
    {% import _self as self %}

    <button type="button" class="btn dropdown-toggle dropdown-toggle--no-caret editorial-notification-toggle" id="{{ id|default('header-drop-2') }}" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" aria-label="Notifications" title="Notifications"><i class="fa fa-bell-o" aria-hidden="true"></i><span class="badge-count editorial-notification-count" style="display: none;"></span></button>
    <ul class="dropdown-menu dropdown-menu-right cart dropdown-animation app-notifications editorial-notifications"
        aria-labelledby="{{ id|default('header-drop-2') }}"
        data-url="{{ path('app_api_notification_index') }}"
        data-prototype="{{ self.renderNotification('__id__', '__message__', '__target_url__', '__image_path__')|escape }}"
        data-placeholder="{{ '/assets/frontend/images/placeholder.png'|imagine_filter('thumbnail') }}"
    >
        <li class="editorial-notifications__heading"><strong>Notifications</strong><span class="editorial-notifications__status">À jour</span></li>
        <li class="editorial-notifications__empty" style="display: none;">Vous n’avez pas de nouvelle notification.</li>
    </ul>
</div>

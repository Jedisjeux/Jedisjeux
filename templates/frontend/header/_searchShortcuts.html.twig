<div class="editorial-search__shortcuts">
    <span class="editorial-search__label">Explorer</span>
    <a href="{{ path('sylius_frontend_product_index', {'criteria': {'reviewCount': {value: 5}}, 'sorting': {'averageRating': 'desc'}}) }}"><i class="fa fa-star" aria-hidden="true"></i>{{ 'app.ui.top_rated'|trans }}</a>
    <a href="{{ path('sylius_frontend_product_index', {'sorting': {'viewCount': 'desc'}}) }}"><i class="fa fa-eye" aria-hidden="true"></i>{{ 'app.ui.most_viewed'|trans }}</a>
    <a href="{{ path('app_frontend_year_award_index') }}"><i class="fa fa-trophy" aria-hidden="true"></i>{{ 'app.ui.award_winning_games'|trans }}</a>
    <a href="{{ path('app_frontend_article_index') }}"><i class="fa fa-newspaper-o" aria-hidden="true"></i>{{ 'app.ui.articles'|trans }}</a>
</div>

<script>
    (function () {
        var menu = document.currentScript.closest('.editorial-search');
        var toggle = document.getElementById(menu.getAttribute('aria-labelledby'));
        toggle.addEventListener('click', function () {
            setTimeout(function () { menu.querySelector('input').focus(); }, 50);
        });
    })();
</script>

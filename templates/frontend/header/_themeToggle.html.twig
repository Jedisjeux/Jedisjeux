{% from 'macro/icon.html.twig' import icon %}
<button type="button" class="editorial-theme-toggle" data-theme-toggle aria-label="Thème : automatique" title="Thème : automatique">
    <span data-theme-icon="auto">{{ icon('monitor') }}</span>
    <span data-theme-icon="light">{{ icon('sun') }}</span>
    <span data-theme-icon="dark">{{ icon('moon') }}</span>
</button>

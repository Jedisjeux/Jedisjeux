<div class="editorial-catalog">
    <!-- breadcrumb start -->
    <!-- ================ -->
    <div class="breadcrumb-container">
        <div class="container">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><i class="fa fa-home pr-2" aria-hidden="true">{{ ux_icon('fa:home', {class: 'fa-svg'}) }}</i><a class="link-dark" href="{{ path('app_homepage') }}">{{ 'sylius.ui.home'|trans }}</a></li>
                {% if product_list.owner is not null and product_list.owner.user is not null %}
                    <li class="breadcrumb-item"><a class="link-dark" href="{{ path('sylius_frontend_user_show', {'username': product_list.owner.user.username}) }}">{{ product_list.owner }}</a></li>
                {% endif %}
                <li class="breadcrumb-item active">{{ pageTitle }}</li>
            </ol>
        </div>
    </div>
    <!-- breadcrumb end -->
    <section class="editorial-catalog__intro">
        <div class="container">
            <span class="editorial-eyebrow">{{ 'app.ui.game_list'|trans }}{% if product_list.owner is not null %} · {{ product_list.owner }}{% endif %}</span>
            <h1>{{ pageTitle }}</h1>
            <p>{{ product_list_items.data.nbResults }} {{ 'app.ui.games'|trans|lower }} dans cette liste.</p>
        </div>
    </section>
</div>

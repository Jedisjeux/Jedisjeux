{% from 'macro/pagination.html.twig' import simple as pagination %}

{% set route = indexPath|default('app_frontend_product_list_item_index') %}
{% set routeParameters = {'productListSlug': app.request.get('productListSlug'), 'criteria': app.request.query.all('criteria')} %}
{% set sorting = app.request.query.all('sorting') %}
{% set oldestFirst = sorting.createdAt is defined and sorting.createdAt == 'asc' %}

<section class="main-container editorial-catalog-results">
    <div class="container">
        <div id="product-list">
            {% if product_list_items.data.nbResults > 0 %}
                <div class="dropdown text-right">
                    <button type="button" class="btn btn-default-transparent dropdown-toggle" data-toggle="dropdown">
                        {{ 'sylius.ui.sort'|trans }} {{ (oldestFirst ? 'sylius.ui.oldest_first' : 'sylius.ui.newest_first')|trans|lower }}
                    </button>
                    <div class="dropdown-menu dropdown-menu-right">
                        <a class="dropdown-item" href="{{ path(route, routeParameters|merge({'sorting': {'createdAt': 'desc'}})) }}">{{ 'sylius.ui.newest_first'|trans }}</a>
                        <a class="dropdown-item" href="{{ path(route, routeParameters|merge({'sorting': {'createdAt': 'asc'}})) }}">{{ 'sylius.ui.oldest_first'|trans }}</a>
                    </div>
                </div>

                <div class="row grid-space-10">
                    {% for product_list_item in product_list_items.data %}
                        <div class="col-6 col-md-6 col-lg-3">
                            {% include 'frontend/product/_catalogCard.html.twig' with {'product': product_list_item.product} %}
                        </div>
                    {% endfor %}
                </div>

                {{ pagination(product_list_items.data) }}
            {% else %}
                <div class="editorial-list-empty">
                    <i class="fa fa-cubes" aria-hidden="true"></i>
                    <p>Aucun jeu dans cette liste pour le moment.</p>
                </div>
            {% endif %}
        </div>
    </div>
</section>

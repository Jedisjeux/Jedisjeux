{% extends 'frontend/layout.html.twig' %}

{% set pageTitle = 'sylius.ui.reset_password'|trans %}

{% block content %}
    <div class="breadcrumb-container">
        <div class="container">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><i class="fa fa-home pr-2"></i><a class="link-dark" href="{{ path('app_homepage') }}">{{ 'sylius.ui.home'|trans }}</a></li>
                <li class="breadcrumb-item active">{{ pageTitle }}</li>
            </ol>
        </div>
    </div>

    <div class="editorial-catalog editorial-login">
        <section class="editorial-catalog__intro">
            <div class="container">
                <span class="editorial-eyebrow">La communauté · Nouveau mot de passe</span>
                <h1>{{ pageTitle }}</h1>
                <p>Choisissez un nouveau mot de passe pour votre compte Jedisjeux.</p>
            </div>
        </section>
    </div>

    <section class="editorial-login-main">
        <div class="container">
            <div class="editorial-login__layout">
                <aside class="editorial-login__welcome">
                    <span class="editorial-eyebrow">Presque fini</span>
                    <h2>Un nouveau départ.</h2>
                    <p>Saisissez votre nouveau mot de passe deux fois pour le confirmer, puis reconnectez-vous.</p>
                    <div class="editorial-login__note"><i class="fa fa-shield" aria-hidden="true"></i><span>Choisissez un mot de passe que vous n’utilisez pas sur d’autres sites.</span></div>
                </aside>
                <div class="editorial-login__panel">
                    <h2>{{ pageTitle }}</h2>
                    <p class="editorial-login__hint">Ce lien n’est valable que pour une durée limitée.</p>

                    {% form_theme form 'frontend/form/horizontal.html.twig' %}
                    <form class="form-horizontal" action="{{ path('sylius_frontend_password_reset', {'token': user.passwordResetToken}) }}" method="POST">
                        {{ form_errors(form) }}
                        {{ form_row(form.password.first) }}
                        {{ form_row(form.password.second) }}
                        {{ form_rest(form) }}

                        <button class="editorial-login__submit" type="submit" id="_submit" name="_submit">{{ 'sylius.ui.reset_button'|trans }} <i class="fa fa-arrow-right" aria-hidden="true"></i></button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    {% include 'frontend/footer/_top.html.twig' %}
{% endblock content %}

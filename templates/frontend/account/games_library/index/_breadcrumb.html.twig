{% set username = app.request.get('username') %}

<div class="breadcrumb-container">
    <div class="container">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><i class="fa fa-home pr-2"></i><a class="link-dark" href="{{ path('app_homepage') }}">{{ 'sylius.ui.home'|trans }}</a></li>
            {% if username %}
                <li class="breadcrumb-item">{{ username }}</li>
            {% else %}
                <li class="breadcrumb-item"><a class="link-dark" href="{{ path('sylius_frontend_account_dashboard') }}">{{ 'sylius.ui.my_account'|trans }}</a></li>
            {% endif %}
            <li class="breadcrumb-item active">{{ pageTitle }}</li>
        </ol>
    </div>
</div>

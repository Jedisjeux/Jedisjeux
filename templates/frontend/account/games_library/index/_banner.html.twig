{% set username = app.request.get('username') %}

<div class="editorial-catalog editorial-account">
    {% include 'frontend/account/games_library/index/_breadcrumb.html.twig' %}
    <section class="editorial-catalog__intro">
        <div class="container">
            <span class="editorial-eyebrow">{% if username %}{{ username }} · {% else %}Mon espace · {% endif %}Étagère virtuelle</span>
            <h1>{{ pageTitle }}</h1>
            <p>{{ product_list_items.data.nbResults }} {{ 'app.ui.games'|trans|lower }} sur l’étagère. Cliquez sur une boîte pour la découvrir.</p>
        </div>
    </section>
    <div class="editorial-catalog__filters">
        {% include 'frontend/account/games_library/index/_filters.html.twig' %}
    </div>
</div>

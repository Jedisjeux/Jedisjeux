{% extends 'frontend/layout.html.twig' %}

{% set pageTitle = 'sylius.ui.forgot_password'|trans %}

{% block content %}
    {% include 'frontend/account/request_password_reset/_breadcrumb.html.twig' %}

    <div class="editorial-catalog editorial-login">
        <section class="editorial-catalog__intro">
            <div class="container">
                <span class="editorial-eyebrow">La communauté · Mot de passe oublié</span>
                <h1>{{ pageTitle }}</h1>
                <p>Pas d’inquiétude, on vous aide à retrouver l’accès à votre compte.</p>
            </div>
        </section>
    </div>

    <section class="editorial-login-main">
        <div class="container">
            <div class="editorial-login__layout">
                <aside class="editorial-login__welcome">
                    <span class="editorial-eyebrow">Ça arrive à tout le monde</span>
                    <h2>On vous remet en jeu.</h2>
                    <p>Indiquez l’adresse email de votre compte : nous vous enverrons un lien pour choisir un nouveau mot de passe.</p>
                    <div class="editorial-login__note"><i class="fa fa-envelope-o" aria-hidden="true"></i><span>Pensez à vérifier vos courriers indésirables si l’email n’arrive pas dans les minutes qui suivent.</span></div>
                </aside>
                <div class="editorial-login__panel">
                    <h2>{{ pageTitle }}</h2>
                    <p class="editorial-login__hint">Recevez un lien de réinitialisation par email.</p>

                    {% form_theme form 'frontend/form/horizontal.html.twig' %}
                    <form action="{{ path('sylius_user_request_password_reset_token') }}" method="post" class="form-horizontal">
                        {{ form_errors(form) }}
                        {{ form_row(form.email, {'label': 'sylius.ui.email', 'attr': {'placeholder': 'sylius.ui.email'}}) }}
                        {{ form_rest(form) }}

                        <button type="submit" class="editorial-login__submit">{{ 'sylius.ui.reset_button'|trans }} <i class="fa fa-arrow-right" aria-hidden="true"></i></button>
                    </form>
                    <p class="editorial-login__register">Vous vous en souvenez ? <a href="{{ path('sylius_frontend_login') }}">{{ 'sylius.ui.login'|trans }}</a></p>
                </div>
            </div>
        </div>
    </section>

    {% include 'frontend/account/request_password_reset/_footerTop.html.twig' %}
{% endblock content %}

{% extends "frontend/layout.html.twig" %}

{% from 'macro/pagination.html.twig' import simple as pagination %}

{% set pageTitle %}
    {{ 'app.ui.game_plays'|trans }}
{% endset %}

{% block content %}
    {% include 'frontend/game_play/indexByProduct/_banner.html.twig' %}

    <!-- main-container start -->
    <!-- ================ -->
    <section class="main-container editorial-catalog-results editorial-game-subpage">

        <div class="container">
            <div class="row">

                <!-- main start -->
                <!-- ================ -->
                <div class="main col-md-12">

                    <div class="row">
                        <div class="col-md-3">
                            {{ component('Product:Box', {slug: app.request.attributes.get('productSlug')}) }}
                        </div>
                        <div class="col-md-9" id="game-play-list">
                            {% include 'frontend/game_play/_list2.html.twig' with {'game_plays': game_plays.data} %}
                            <!-- pagination start -->
                            {{ pagination(game_plays.data) }}
                            <!-- pagination end -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {% include 'frontend/footer/_top.html.twig' %}
{% endblock content %}

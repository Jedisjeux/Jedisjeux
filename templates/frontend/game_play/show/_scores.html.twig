{% import 'macro/image.html.twig' as images %}

{% if game_play.players|length > 0 %}
    <!-- scores section start -->
    <!-- ================ -->
    <section class="editorial-play-section editorial-play-scores">
        <div class="container">
            <div class="editorial-play-section__inner">
                <header class="editorial-play-section__heading">
                    <span class="editorial-eyebrow">À la table</span>
                    <h2>Scores</h2>
                    <p>Les résultats des joueurs pour cette partie.</p>
                </header>
                <div class="table-responsive">
                    <table class="table editorial-play-score-table">
                        <thead>
                        <tr>
                            <th>#</th>
                            <th>{{ 'sylius.ui.name'|trans }}</th>
                            <th>{{ 'app.ui.score'|trans }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for player in game_play.players %}
                            {% set customer = player.customer %}
                            {% set avatarPath = customer is not null and customer.avatar is not null ? customer.avatar.webPath : '/assets/frontend/images/avatar-placeholder.png'  %}
                            <tr>
                                <td><span class="editorial-play-score-table__rank">{{ loop.index }}</span></td>
                                <td>{{ player.name }}</td>
                                <td>{{ player.score }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
    <!-- scores section end -->
{% endif %}

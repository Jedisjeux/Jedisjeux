{% import 'macro/image.html.twig' as images  %}

{% if game_play.images|length > 0 %}
    <!-- photos section start -->
    <!-- ================ -->
    <section class="editorial-play-section editorial-play-photos">
        <div class="container">
            <div class="editorial-play-section__inner">
                <header class="editorial-play-section__heading">
                    <span class="editorial-eyebrow">Souvenirs de table</span>
                    <h2>Photos de la partie</h2>
                    <p>{{ game_play.images|length }} photo{% if game_play.images|length != 1 %}s{% endif %} partagée{% if game_play.images|length != 1 %}s{% endif %} par la communauté.</p>
                </header>
                <div class="slick-carousel content-slider-with-thumbs mb-20">
                    {% for image in game_play.images %}
                        <div class="overlay-container overlay-visible">
                            {{ images.render(image.webPath, 'full', image.description) }}
                            <a href="{{ image.webPath | imagine_filter(filter|default('full')) }}"
                               class="slick-carousel--popup-img overlay-link"
                               title="{{ image.description }}"><i class="fa fa-plus"></i></a>
                        </div>
                    {% endfor %}
                </div>
                <div class="content-slider-thumbs-container">
                    <div class="slick-carousel content-slider-thumbs">
                        {% for image in game_play.images %}
                            <div class="slick-nav-thumb">
                                {{ images.render(image.webPath, 'magazine_item', image.description) }}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- photos section end -->
{% endif %}

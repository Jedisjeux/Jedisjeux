{% from 'macro/icon.html.twig' import icon %}
{% extends 'frontend/layout.html.twig' %}

{% block content %}
    <div id="page-start"></div>

    <section class="editorial-hero">
        <div class="container">
            <div class="editorial-hero__copy">
                <span class="editorial-eyebrow">Jedisjeux · et les autres jours aussi</span>
                <h1>Le jeu,<br>tous les jours.</h1>
                <p>Des jeux à découvrir, des histoires à lire et une communauté de passionnés avec qui partager.</p>
                <a class="btn btn-default" href="{{ path('app_frontend_article_index') }}">Explorer le magazine {{ icon('arrow-right') }}</a>
            </div>
        </div>
    </section>

    <section class="section editorial-home">
        <div class="container">
            <div class="editorial-section-heading">
                <div><span class="editorial-eyebrow">Le magazine</span><h2>Derniers articles</h2></div>
                <a href="{{ path('app_frontend_article_index') }}">Tous les articles {{ icon('arrow-right') }}</a>
            </div>
            <div id="latest-articles">{% include 'frontend/homepage/index/_latestArticles.html.twig' %}</div>
        </div>
    </section>
    {% include 'frontend/homepage/index/_latestProducts.html.twig' %}
    {{ render(url('app_counter_index')) }}
{% endblock content %}

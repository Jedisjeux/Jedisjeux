{% extends 'frontend/layout.html.twig' %}
{% import 'macro/page_views.html.twig' as page_views %}

{% set pageTitle %}
    {{ product.name }}
{% endset %}

{% block content %}
    <div itemscope itemtype="http://schema.org/Game">
        {% include 'frontend/product/show/_banner.html.twig' %}
        {% include 'frontend/product/show/_main.html.twig' %}
        {% include 'frontend/product/show/_content.html.twig' %}
    </div>
    {% include 'frontend/product/show/_variants.html.twig' %}
    {% include 'frontend/product/show/_associations.html.twig' %}
    {% include 'frontend/product/show/_footerTop.html.twig' %}
    {{ page_views.render(product.id, 'products') }}
{% endblock content %}

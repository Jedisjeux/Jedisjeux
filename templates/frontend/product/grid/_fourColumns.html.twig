<div class="row grid-space-10">
    {% for product in products.data %}
        <div class="{% if editorial_catalog|default(false) %}col-6 col-md-6 col-lg-3{% else %}col-lg-3 col-md-6{% endif %}">
            {% if editorial_catalog|default(false) %}
                {% include 'frontend/product/_catalogCard.html.twig' %}
            {% else %}
                {% include 'frontend/product/_single.html.twig' %}
            {% endif %}
        </div>
    {% endfor %}
</div>

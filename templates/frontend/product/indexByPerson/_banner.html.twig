<div class="editorial-catalog">
    {% include 'frontend/product/indexByPerson/_breadcrumb.html.twig' %}
    <section class="editorial-catalog__intro">
        <div class="container">
            <span class="editorial-eyebrow">La ludothèque · Auteur et illustrateur</span>
            <h1>{{ person }}</h1>
            {% if person.description is not empty %}<div class="editorial-catalog__description">{{ person.description|raw }}</div>{% endif %}
        </div>
    </section>
    <div class="editorial-catalog__filters">
        {% include 'frontend/product/index/_filters.html.twig' %}
    </div>
</div>

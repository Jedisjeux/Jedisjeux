<div class="editorial-catalog">
    {% include 'frontend/product/indexByTaxon/_breadcrumb.html.twig' %}
    <section class="editorial-catalog__intro">
        <div class="container">
            <span class="editorial-eyebrow">La ludothèque</span>
            <h1>{{ taxon.name }}</h1>
            {% if taxon.description is not empty %}<div class="editorial-catalog__description">{{ taxon.description|raw }}</div>{% endif %}

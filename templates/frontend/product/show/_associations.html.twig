{% for association in product.associations %}
    <section class="section editorial-products editorial-game-associations" id="sylius-product-association-{{ association.type.name }}">
        <div class="container">
            <div class="editorial-section-heading">
                <div><span class="editorial-eyebrow">Pour aller plus loin</span><h2>{{ association.type }}</h2></div>
            </div>
            {% include 'frontend/product/_list.html.twig' with {'products': association.associatedProducts} %}
        </div>
    </section>
{% endfor %}

{% from 'macro/icon.html.twig' import icon %}

<div class="space-top">
    {{ component('GamePlay:LatestForProduct', {productId: product.id}) }}

    <div class="editorial-game-play-actions">
        <a class="editorial-review-more" href="{{ path('app_frontend_game_play_index_by_product', {'productSlug': product.slug}) }}">
            {{ 'app.ui.view_more_game_plays'|trans }} {{ icon('arrow-right') }}
        </a>
        <a class="editorial-review-more" href="{{ path('app_frontend_game_play_create', {'productSlug': product.slug}) }}">
            {{ icon('pen') }} {{ 'app.ui.register_a_game_play'|trans }}
        </a>
    </div>
</div>

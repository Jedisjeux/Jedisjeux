{% from 'macro/icon.html.twig' import icon %}
{% import 'macro/image.html.twig' as images %}
{% from 'macro/product.html.twig' import releasedAt, duration, playerCount %}

{% set productPath = path('sylius_frontend_product_show', { 'slug': product.slug }) %}

<article class="editorial-catalog-card" itemscope itemtype="https://schema.org/Game">
    <a class="editorial-catalog-card__image{{ card_award is defined ? ' editorial-catalog-card__image--awarded' }}" href="{{ productPath }}" aria-label="{{ product.name }}">
        {% if product.mainImage is not null %}
            {{ images.fit(product.mainImage.webPath, product.name) }}
        {% else %}
            <span class="editorial-catalog-card__placeholder"><i class="fa fa-cubes" aria-hidden="true">{{ ux_icon('fa:cubes', {class: 'fa-svg'}) }}</i></span>
        {% endif %}
        {% if card_award is defined and card_award.award is not null %}
            {% set awardImage = card_award.award.image %}
            <span class="editorial-catalog-card__award">
                {% if awardImage is not null and awardImage.webPath is not null %}
                    <img class="editorial-catalog-card__award-logo" src="{{ awardImage.webPath|imagine_filter('thumbnail') }}" alt="" loading="lazy">
                {% else %}
                    <span class="editorial-catalog-card__award-logo"><i class="fa fa-trophy" aria-hidden="true">{{ ux_icon('fa:trophy', {class: 'fa-svg'}) }}</i></span>
                {% endif %}
                <span class="editorial-catalog-card__award-text">
                    <strong>{{ card_award.award.name }}</strong>
                    {% if card_award.year is not empty %}<span>{{ card_award.year }}</span>{% endif %}
                </span>
            </span>
        {% endif %}
    </a>
    <div class="editorial-catalog-card__body">
        {% set card_category = card_category|default(product.mainTaxon is not null ? product.mainTaxon.name : null) %}
        {% if card_category is not empty %}<span class="editorial-catalog-card__category">{{ card_category }}</span>{% endif %}
        <h2 itemprop="name"><a href="{{ productPath }}">{{ product.name }}</a></h2>

        {% if product.averageRating > 0 %}
            <div class="editorial-catalog-card__rating" itemprop="aggregateRating" itemscope itemtype="https://schema.org/AggregateRating">
                {{ icon('star') }}
                <strong>{{ product.averageRating|round(1) }}<small>/10</small></strong>
                {% if product.reviewCount > 0 %}<span>({{ product.reviewCount }} note{{ product.reviewCount > 1 ? 's' }})</span>{% endif %}
                <meta itemprop="ratingValue" content="{{ product.averageRating|round(1) }}">
                <meta itemprop="bestRating" content="10">
                <meta itemprop="worstRating" content="1">
                <meta itemprop="ratingCount" content="{{ product.reviewCount }}">
            </div>
        {% else %}
            <div class="editorial-catalog-card__rating editorial-catalog-card__rating--empty">Pas encore noté</div>
        {% endif %}

        {% if product.shortDescription is not null %}
            <p class="editorial-catalog-card__description">{{ product.shortDescription|u.truncate(120, '...', false)|striptags|raw }}</p>
        {% endif %}

        <ul class="editorial-catalog-card__facts">
            <li>{{ icon('user') }}{{ playerCount(product) }}</li>
            {% if product.minAge is not null %}<li>{{ icon('age') }}{{ product.minAge }}+</li>{% endif %}
            {% if product.minDuration is not null %}<li>{{ icon('clock') }}{{ duration(product) }}</li>{% endif %}
        </ul>
        <div class="editorial-catalog-card__release">Sortie : {{ releasedAt(product.firstVariant) }}</div>
    </div>
</article>

{
  "name": "jedisjeux/jedisjeux",
  "description": "Boardgames website, based on Symfony framework.",
  "license": "MIT",
  "type": "project",
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "DoctrineMigrations\\": "src/Migrations"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.2",
    "ext-zip": "*",
    "doctrine/doctrine-bundle": "^1.12 || ^2.0",
    "doctrine/doctrine-fixtures-bundle": "^3.4",
    "doctrine/doctrine-migrations-bundle": "^3.2",
    "doctrine/migrations": "^3.5",
    "doctrine/orm": "^2.5",
    "eightpoints/guzzle-bundle": "^8.0",
    "eko/feedbundle": "^2.2",
    "excelwebzone/recaptcha-bundle": "^1.5",
    "fakerphp/faker": "^1.14",
    "friendsofsymfony/ckeditor-bundle": "^2.0",
    "friendsofsymfony/jsrouting-bundle": "^3.5",
    "friendsofsymfony/rest-bundle": "^3.8",
    "gesdinet/jwt-refresh-token-bundle": "^1.0",
    "google/apiclient": "^2.0",
    "guzzlehttp/guzzle": "^6.2 || ^7.0",
    "incenteev/hashed-asset-bundle": "^1.0",
    "karser/karser-recaptcha3-bundle": "^0.1.3",
    "lexik/jwt-authentication-bundle": "^3.1",
    "liip/imagine-bundle": "^2.1",
    "nelmio/cors-bundle": "^2.0",
    "pagerfanta/doctrine-orm-adapter": "^4.6",
    "pagerfanta/pagerfanta": "^4.6",
    "pagerfanta/twig": "^4.6",
    "phpdocumentor/reflection-docblock": "^5.6",
    "presta/sitemap-bundle": "^4.1",
    "psr/event-dispatcher": "^1.0",
    "ramsey/uuid": "^3.8 || ^4.0",
    "sonata-project/block-bundle": "^5.1",
    "sylius-labs/association-hydrator": "^1.1",
    "sylius/admin-ui": "^0.14",
    "sylius/bootstrap-admin-ui": "^0.14",
    "sylius/customer-bundle": "^2.0",
    "sylius/fixtures-bundle": "^1.7",
    "sylius/grid-bundle": "^1.9",
    "sylius/locale-bundle": "^2.0",
    "sylius/mailer": "^2.0",
    "sylius/mailer-bundle": "^2.0",
    "sylius/money-bundle": "^2.0",
    "sylius/product-bundle": "^2.0",
    "sylius/resource": "^1.10",
    "sylius/resource-bundle": "^1.8",
    "sylius/review-bundle": "^2.0",
    "sylius/taxonomy-bundle": "^2.0",
    "sylius/user": "^2.0",
    "sylius/user-bundle": "^2.0",
    "symfony/asset": "7.4.*",
    "symfony/asset-mapper": "7.4.*",
    "symfony/config": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/expression-language": "7.4.*",
    "symfony/flex": "^2.4",
    "symfony/mailer": "7.4.*",
    "symfony/messenger": "7.4.*",
    "symfony/monolog-bundle": "^3.1",
    "symfony/process": "7.4.*",
    "symfony/property-access": "7.4.*",
    "symfony/property-info": "7.4.*",
    "symfony/routing": "7.4.*",
    "symfony/security-bundle": "7.4.*",
    "symfony/serializer": "7.4.*",
    "symfony/translation": "7.4.*",
    "symfony/twig-bundle": "7.4.*",
    "symfony/validator": "7.4.*",
    "twig/extra-bundle": "^3.7",
    "twig/intl-extra": "^3.7",
    "twig/string-extra": "^3.7",
    "twig/twig": "^3.8",
    "vich/uploader-bundle": "^2.4",
    "webmozart/assert": "^1.9",
    "willdurand/hateoas-bundle": "^2.7",
    "winzou/state-machine-bundle": "^0.5 || ^0.6",
    "zenstruck/foundry": "^1.14",
    "zenstruck/redirect-bundle": "^3.1"
  },
  "require-dev": {
    "behat/behat": "^3.2",
    "behat/gherkin": "^4.18",
    "behat/mink-selenium2-driver": "~1.6.0",
    "dbrekelmans/bdi": "^1.4",
    "dmore/behat-chrome-extension": "^1.4",
    "dmore/chrome-mink-driver": "^2.9",
    "friends-of-behat/mink": "^1.8",
    "friends-of-behat/mink-browserkit-driver": "^1.4",
    "friends-of-behat/mink-debug-extension": "^2.0",
    "friends-of-behat/mink-extension": "^2.4",
    "friends-of-behat/page-object-extension": "^0.3",
    "friends-of-behat/symfony-extension": "^2.0",
    "friends-of-behat/variadic-extension": "^1.1",
    "friendsofphp/php-cs-fixer": "^3.0",
    "lchrusciel/api-test-case": "^5.1",
    "phpstan/phpstan": "^1.5",
    "phpstan/phpstan-doctrine": "^1.3",
    "phpstan/phpstan-nette": "^1.0",
    "phpstan/phpstan-symfony": "^1.1",
    "phpstan/phpstan-webmozart-assert": "^1.1",
    "phpunit/phpunit": "^11.5",
    "se/selenium-server-standalone": "2.*",
    "symfony/debug-bundle": "7.4.*",
    "symfony/web-profiler-bundle": "7.4.*",
    "vimeo/psalm": "^6.0"
  },
  "conflict": {
    "doctrine/inflector": "^1.4",
    "symfony/symfony": "*"
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "ckeditor:install --tag=4.6.0 --clear=drop": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd",
      "importmap:install": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ]
  },
  "config": {
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true,
    "allow-plugins": {
      "symfony/flex": true,
      "infection/extension-installer": false,
      "php-http/discovery": false
    },
    "platform": {
      "php": "8.2.27"
    },
    "audit": {
      "block-insecure": false
    }
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "7.4.*"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}

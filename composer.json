{
  "name": "jedisjeux/jedisjeux",
  "description": "Boardgames website, based on Symfony framework.",
  "license": "MIT",
  "type": "project",
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "DoctrineMigrations\\": "src/Migrations"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.2",
    "ext-zip": "*",
    "api-platform/core": "^2.6",
    "doctrine/doctrine-bundle": "^1.12 || ^2.0",
    "doctrine/doctrine-fixtures-bundle": "^3.4",
    "doctrine/doctrine-migrations-bundle": "^3.2",
    "doctrine/migrations": "^3.5",
    "doctrine/orm": "^2.5",
    "eightpoints/guzzle-bundle": "^8.0",
    "eko/feedbundle": "^2.2",
    "excelwebzone/recaptcha-bundle": "^1.5",
    "fakerphp/faker": "^1.14",
    "friendsofsymfony/ckeditor-bundle": "^2.0",
    "friendsofsymfony/jsrouting-bundle": "^2.2",
    "friendsofsymfony/oauth-server-bundle": "^2.0@dev",
    "gesdinet/jwt-refresh-token-bundle": "^1.0",
    "google/apiclient": "^2.0",
    "guzzlehttp/guzzle": "^6.2 || ^7.0",
    "incenteev/hashed-asset-bundle": "^1.0",
    "karser/karser-recaptcha3-bundle": "^0.1.3",
    "lexik/jwt-authentication-bundle": "^2.14",
    "liip/imagine-bundle": "^2.1",
    "monofony/admin": "^0.9",
    "monofony/admin-contracts": "^0.9",
    "monofony/admin-meta": "^0.9",
    "monofony/api-contracts": "^0.9",
    "monofony/api-meta": "^0.9",
    "monofony/core-bundle": "^0.9",
    "monofony/core-contracts": "^0.9",
    "monofony/core-meta": "^0.9",
    "monofony/front-contracts": "^0.9",
    "monofony/front-meta": "^0.9",
    "monofony/sylius-user-bridge": "^0.9",
    "nelmio/cors-bundle": "^2.0",
    "pagerfanta/doctrine-orm-adapter": "^3.8",
    "pagerfanta/pagerfanta": "^3.5",
    "pagerfanta/twig": "^3.8",
    "phpdocumentor/reflection-docblock": "^5.6",
    "phpstan/phpdoc-parser": "^2.3",
    "presta/sitemap-bundle": "^2.1",
    "psr/event-dispatcher": "^1.0",
    "ramsey/uuid": "^3.8 || ^4.0",
    "sensio/framework-extra-bundle": "^5.1 || ^6.0",
    "sonata-project/block-bundle": "^4.2",
    "sylius-labs/association-hydrator": "^1.1",
    "sylius/customer-bundle": "^1.10",
    "sylius/fixtures-bundle": "^1.7",
    "sylius/grid-bundle": "^1.9",
    "sylius/locale-bundle": "^1.10",
    "sylius/mailer": "^2.0",
    "sylius/mailer-bundle": "^2.0",
    "sylius/money-bundle": "^1.10",
    "sylius/product-bundle": "^1.13",
    "sylius/resource": "^1.10",
    "sylius/resource-bundle": "^1.8",
    "sylius/review-bundle": "^1.10",
    "sylius/taxonomy-bundle": "^1.10",
    "sylius/ui-bundle": "^1.10",
    "sylius/user": "^1.12",
    "sylius/user-bundle": "^1.10",
    "symfony/asset": "^5.4 || ^6.0",
    "symfony/config": "^5.4 || ^6.0",
    "symfony/dotenv": "5.4.*",
    "symfony/expression-language": "5.4.*",
    "symfony/flex": "^1.9",
    "symfony/messenger": "^5.4 || ^6.0",
    "symfony/monolog-bundle": "^3.1",
    "symfony/process": "^5.4 || ^6.0",
    "symfony/property-access": "5.4.*",
    "symfony/property-info": "5.4.*",
    "symfony/routing": "^5.4 || ^6.0",
    "symfony/security-bundle": "5.4.*",
    "symfony/serializer": "^5.4 || ^6.0",
    "symfony/templating": "^5.4 || ^6.0",
    "symfony/translation": "^5.4 || ^6.0",
    "symfony/twig-bundle": "5.4.*",
    "symfony/validator": "^5.4 || ^6.0",
    "symfony/webpack-encore-bundle": "^1.7",
    "twig/extensions": "^1.5",
    "twig/twig": "^2.7",
    "vich/uploader-bundle": "^1.8",
    "webmozart/assert": "^1.9",
    "winzou/state-machine-bundle": "^0.5 || ^0.6",
    "zenstruck/foundry": "^1.14",
    "zenstruck/redirect-bundle": "^3.1"
  },
  "require-dev": {
    "behat/behat": "^3.2",
    "behat/gherkin": "~4.12.0",
    "behat/mink-selenium2-driver": "~1.6.0",
    "dbrekelmans/bdi": "^1.4",
    "dmore/behat-chrome-extension": "^1.4",
    "dmore/chrome-mink-driver": "^2.9",
    "friends-of-behat/mink": "^1.8",
    "friends-of-behat/mink-browserkit-driver": "^1.4",
    "friends-of-behat/mink-debug-extension": "^2.0",
    "friends-of-behat/mink-extension": "^2.4",
    "friends-of-behat/page-object-extension": "^0.3",
    "friends-of-behat/symfony-extension": "^2.0",
    "friends-of-behat/variadic-extension": "^1.1",
    "friends-of-phpspec/phpspec-code-coverage": "^6.0",
    "friendsofphp/php-cs-fixer": "^3.0",
    "lchrusciel/api-test-case": "^5.1",
    "monofony/behat-bridge": "^0.9",
    "phpspec/phpspec": "^7.2",
    "phpstan/phpstan": "^1.5",
    "phpstan/phpstan-doctrine": "^1.3",
    "phpstan/phpstan-nette": "^1.0",
    "phpstan/phpstan-symfony": "^1.1",
    "phpstan/phpstan-webmozart-assert": "^1.1",
    "se/selenium-server-standalone": "2.*",
    "symfony/debug-bundle": "^5.4 || ^6.0",
    "symfony/web-profiler-bundle": "^5.4 || ^6.0",
    "vimeo/psalm": "^4.22"
  },
  "conflict": {
    "doctrine/inflector": "^1.4",
    "symfony/symfony": "*"
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "ckeditor:install --tag=4.6.0 --clear=drop": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ]
  },
  "config": {
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true,
    "allow-plugins": {
      "symfony/flex": true,
      "infection/extension-installer": false,
      "php-http/discovery": false
    },
    "platform": {
      "php": "8.2.0"
    },
    "audit": {
      "block-insecure": false
    }
  },
  "extra": {
      "symfony": {
          "allow-contrib": false,
          "require": "5.4.*"
      }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}

---
// Same wordmark as the admin sidebar (templates/backend/layout/logo.html.twig)
const href = import.meta.env.BASE_URL;
---

<a href={href} class="app-logo">
    <span class="app-logo__name">Jedisjeux</span>
    <span class="app-logo__slogan">Et les autres jours aussi...</span>
</a>

<style>
    .app-logo {
        display: inline-flex;
        flex-direction: column;
        line-height: 1;
        text-decoration: none;
    }

    .app-logo__name {
        color: #09afdf;
        font-family: 'Noto Serif JP', serif;
        font-size: 1.6rem;
        font-weight: 700;
        letter-spacing: -0.01em;
    }

    .app-logo__slogan {
        color: var(--sl-color-gray-3);
        font-size: 0.7rem;
        font-weight: 300;
        margin-top: 0.35rem;
        white-space: nowrap;
    }
</style>
